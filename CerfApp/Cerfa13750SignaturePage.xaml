<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CerfApp.Controls"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="CerfApp.Cerfa13750SignaturePage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <controls:HeaderView Grid.Row="0"
                             x:Name="Header"
                             ShowSettings="False" />

        <Grid Grid.Row="1" Margin="16">

            <Label x:Name="InstructionLabel"
                   VerticalOptions="Start"
                   HorizontalOptions="Center"
                   FontSize="13"
                   TextColor="Gray"
                   Margin="0,8,0,0" />

            <Border Margin="0,40,0,0"
                    Stroke="#CCCCCC"
                    StrokeThickness="1"
                    BackgroundColor="White">
                <skia:SKCanvasView x:Name="CanvasView"
                                   EnableTouchEvents="True"
                                   PaintSurface="OnPaintSurface"
                                   Touch="OnTouch" />
            </Border>

        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*, *"
              Padding="16,8,16,16"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Text="Effacer"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource BrandAccent}"
                    BorderColor="{StaticResource BrandAccent}"
                    BorderWidth="1.5"
                    Clicked="OnEffacerClicked" />

            <Button Grid.Column="1"
                    x:Name="ValiderButton"
                    Text="Valider →"
                    Clicked="OnValiderClicked" />

        </Grid>

    </Grid>

</ContentPage>
