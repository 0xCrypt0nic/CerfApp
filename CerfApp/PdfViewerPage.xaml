<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CerfApp.Controls"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="CerfApp.PdfViewerPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <controls:HeaderView Grid.Row="0"
                             PageTitle="Aperçu du document"
                             ShowSettings="False" />

        <!-- Indicateur de chargement -->
        <ActivityIndicator Grid.Row="1"
                           x:Name="Loader"
                           IsRunning="True"
                           IsVisible="True"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Pages du PDF -->
        <ScrollView Grid.Row="1" x:Name="PdfScrollView" IsVisible="False">
            <VerticalStackLayout x:Name="PagesContainer"
                                 Spacing="4"
                                 Padding="0" />
        </ScrollView>

        <Button Grid.Row="2"
                Text="⬆  Partager"
                Clicked="OnPartagerClicked"
                BackgroundColor="{StaticResource BrandAccent}"
                TextColor="White"
                CornerRadius="8"
                Margin="16,8,16,16"
                HorizontalOptions="Fill" />

    </Grid>

</ContentPage>
