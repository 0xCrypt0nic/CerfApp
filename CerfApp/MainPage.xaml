<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CerfApp.Controls"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="CerfApp.MainPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <controls:HeaderView Grid.Row="0"
                             PageTitle="CerfApp"
                             ShowBack="False"
                             ShowSettings="True" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="16"
                             Padding="24"
                             VerticalOptions="Center">

            <Label Text="Choisissez un formulaire"
                   FontSize="16"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16" />

            <Button Text="Certificat de cession 15776*02"
                    Clicked="OnCerfa15776Clicked"
                    HorizontalOptions="Fill" />

            <Button Text="Certificat d'immatriculation 13750*07"
                    Clicked="OnCerfa13750Clicked"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
