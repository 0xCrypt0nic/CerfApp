<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CerfApp.Controls"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="CerfApp.Cerfa13750TitulairePage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <controls:HeaderView Grid.Row="0"
                             PageTitle="Certificat d'immatriculation (13750*07)"
                             ShowBack="True"
                             ShowSettings="False" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="0">

                <Label Text="LE TITULAIRE"
                       FontAttributes="Bold" FontSize="15"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       Margin="0,8,0,12" />

                <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                    <RadioButton x:Name="PersonnePhysiqueRadio"
                                 Content="Personne physique"
                                 GroupName="GrpTypeTit"
                                 CheckedChanged="OnTypePersonneChanged" />
                    <HorizontalStackLayout x:Name="SexeLayout" Spacing="16" HorizontalOptions="Center">
                        <RadioButton x:Name="SexeMRadio" Content="M" GroupName="GrpSexeTit" />
                        <RadioButton x:Name="SexeFRadio" Content="F" GroupName="GrpSexeTit" />
                    </HorizontalStackLayout>
                    <RadioButton x:Name="PersonneMoraleRadio"
                                 Content="Personne morale"
                                 GroupName="GrpTypeTit"
                                 CheckedChanged="OnTypePersonneChanged" />
                </VerticalStackLayout>

                <Label Text="SIRET" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="SiretEntry" Placeholder="14 chiffres" Keyboard="Numeric" MaxLength="14" Style="{StaticResource FieldEntry}" />

                <Label Text="Nom, Prénom (ou Raison sociale)" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="NomPrenomEntry" Placeholder="ex : DUPONT Jean" Style="{StaticResource FieldEntry}" />

                <Label Text="Nom d'usage" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="NomUsageEntry" Placeholder="Optionnel" Style="{StaticResource FieldEntry}" />

                <VerticalStackLayout x:Name="NaissanceLayout" Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="Date de naissance" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NaissanceEntry" Placeholder="JJ/MM/AAAA" Keyboard="Numeric"
                                   WidthRequest="110" HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Commune de naissance" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="VilleNaissEntry" Placeholder="ex : PARIS"
                                   HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="Dép." Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="DepNaissEntry" Placeholder="75"
                                   HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Pays de naissance" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="PaysNaissEntry" Placeholder="FRANCE"
                                   HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Label Text="ADRESSE" FontAttributes="Bold" FontSize="13"
                       Margin="0,12,0,8" />

                <Label Text="Étage / Escalier / Appartement" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="EtageEntry" Placeholder="Optionnel" Style="{StaticResource FieldEntry}" />

                <Label Text="Immeuble / Résidence / Bâtiment" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="ImmeubleEntry" Placeholder="Optionnel" Style="{StaticResource FieldEntry}" />

                <Grid ColumnDefinitions="80,80,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                        <Label Text="N° voie" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="NumVoieEntry" Placeholder="12"
                               HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Text="Ext." Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="ExtensionEntry" Placeholder="bis"
                               HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="0">
                        <Label Text="Type de voie" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="TypeVoieEntry" Placeholder="RUE"
                               HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Text="Libellé de la voie" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="NomVoieEntry" Placeholder="ex : DE LA PAIX" Style="{StaticResource FieldEntry}" />

                <Label Text="Lieu-dit / BP / Localité" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="LieuDitEntry" Placeholder="Optionnel" Style="{StaticResource FieldEntry}" />

                <Grid ColumnDefinitions="108,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                        <Label Text="Code postal" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="CodePostalEntry" Placeholder="75001" Keyboard="Numeric" MaxLength="5"
                               HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Text="Commune" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="CommuneEntry" Placeholder="PARIS"
                               HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Text="Téléphone" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="TelephoneEntry" Placeholder="06 00 00 00 00" Keyboard="Telephone" Style="{StaticResource FieldEntry}" />

                <Label Text="E-mail" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="MailEntry" Placeholder="exemple@mail.fr" Keyboard="Email" Style="{StaticResource FieldEntry}" />

                <Label Text="CO-TITULAIRE(S)" FontAttributes="Bold" FontSize="13"
                       Margin="0,12,0,8" />

                <Label Text="Nombre de co-titulaires" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="NbCotitEntry" Placeholder="0" Keyboard="Numeric" MaxLength="2" Style="{StaticResource FieldEntry}" />

                <Label Text="Nom / Prénom co-titulaire" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="CotitNomEntry" Placeholder="Optionnel" Style="{StaticResource FieldEntry}" />

                <Label Text="SIRET co-titulaire" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="CotitSiretEntry" Placeholder="Optionnel" Keyboard="Numeric" MaxLength="14" Style="{StaticResource FieldEntry}" />

                <Label Text="SIGNATURE" FontAttributes="Bold" FontSize="13"
                       Margin="0,12,0,8" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                        <Label Text="Fait à" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="VilleSignEntry" Placeholder="ex : PARIS"
                               HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Text="Le" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="DateSignEntry" Placeholder="JJ/MM/AAAA" Keyboard="Numeric"
                               WidthRequest="110" HorizontalTextAlignment="Center" Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Style="{StaticResource FooterGrid}"
              ColumnDefinitions="*, *">

            <Button Grid.Column="0"
                    Text="Scanner"
                    Clicked="OnScanClicked" />

            <Button Grid.Column="1"
                    x:Name="SuivantButton"
                    Text="Suivant"
                    Clicked="OnSuivantClicked" />

        </Grid>

    </Grid>

</ContentPage>
