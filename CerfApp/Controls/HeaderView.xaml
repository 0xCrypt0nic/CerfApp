<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CerfApp.Controls.HeaderView"
             x:Name="self"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">

    <Grid RowDefinitions="*, 1">

        <!-- Ligne principale : retour | titre | paramètres -->
        <Grid Grid.Row="0"
              ColumnDefinitions="56, *, 56"
              HeightRequest="52">

            <!-- Bouton retour -->
            <Label Grid.Column="0"
                   Text="&#xf060;"
                   FontFamily="FaSolid"
                   FontSize="18"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=White}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding ShowBack, Source={x:Reference self}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Titre toujours centré sur la colonne du milieu -->
            <Label Grid.Column="1"
                   Text="{Binding PageTitle, Source={x:Reference self}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   FontAttributes="Bold" />

            <!-- Bouton paramètres -->
            <Button Grid.Column="2"
                    Text="⚙"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=White}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    IsVisible="{Binding ShowSettings, Source={x:Reference self}}"
                    Clicked="OnSettingsClicked" />

        </Grid>

        <!-- Ligne de séparation -->
        <BoxView Grid.Row="1"
                 Color="{AppThemeBinding Light=#DEDEDE, Dark=#3A3A3C}" />

    </Grid>

</ContentView>
