<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CerfApp.Controls.HeaderView"
             x:Name="self"
             BackgroundColor="{StaticResource BrandHeader}">

    <Grid RowDefinitions="*, 1">

        <!-- Ligne principale : retour | titre | paramètres -->
        <Grid Grid.Row="0"
              ColumnDefinitions="56, *, 56"
              HeightRequest="52">

            <!-- Bouton retour -->
            <Label Grid.Column="0"
                   Text="&#xf060;"
                   FontFamily="FaSolid"
                   FontSize="18"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding ShowBack, Source={x:Reference self}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Titre toujours centré sur la colonne du milieu -->
            <Label Grid.Column="1"
                   Text="{Binding PageTitle, Source={x:Reference self}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="White"
                   FontSize="14"
                   FontAttributes="Bold" />

            <!-- Colonne droite vide (symétrie avec le bouton retour) -->

        </Grid>

        <!-- Ligne de séparation -->
        <BoxView Grid.Row="1"
                 Color="{StaticResource BrandHeaderSeparator}" />

    </Grid>

</ContentView>
