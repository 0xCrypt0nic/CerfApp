<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CessionApp.ScanPage"
             Title="Scanner"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">

        <toolkit:CameraView x:Name="CameraView"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            MediaCaptured="OnMediaCaptured" />

        <!-- Panneau de statut -->
        <Border Grid.Row="1"
                BackgroundColor="#EE111111"
                Padding="14,10,14,14">
            <VerticalStackLayout Spacing="5">

                <Grid ColumnDefinitions="20,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="5">

                    <Label x:Name="IconA"  Grid.Row="0" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextA"  Grid.Row="0" Grid.Column="1" Text="(A)  Immatriculation" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconE"  Grid.Row="1" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextE"  Grid.Row="1" Grid.Column="1" Text="(E)  N° d'identification (VIN)" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconD1" Grid.Row="2" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextD1" Grid.Row="2" Grid.Column="1" Text="(D.1)  Marque" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconD2" Grid.Row="3" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextD2" Grid.Row="3" Grid.Column="1" Text="(D.2)  Type / variante / version" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconD3" Grid.Row="4" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextD3" Grid.Row="4" Grid.Column="1" Text="(D.3)  Dénomination commerciale" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconJ1" Grid.Row="5" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextJ1" Grid.Row="5" Grid.Column="1" Text="(J.1)  Genre national" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconB"  Grid.Row="6" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextB"  Grid.Row="6" Grid.Column="1" Text="(B)  Date 1re immatriculation" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                </Grid>

                <!-- Ligne numéro de formule — format SIV (nouveau) -->
                <Grid x:Name="NumFormuleRow" ColumnDefinitions="20,*" ColumnSpacing="8" IsVisible="False" Margin="0,5,0,0">
                    <Label x:Name="IconNF" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextNF" Grid.Column="1" Text="N°  Numéro de formule" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>
                </Grid>

                <!-- Ligne date certificat (I) — format FNI (ancien) -->
                <Grid x:Name="DateCertRow" ColumnDefinitions="20,*" ColumnSpacing="8" IsVisible="False" Margin="0,5,0,0">
                    <Label x:Name="IconI" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextI" Grid.Column="1" Text="(I)  Date du certificat" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>
                </Grid>

                <Button Text="Terminer"
                        Clicked="OnTerminerClicked"
                        Margin="0,6,0,0"
                        HeightRequest="38"
                        FontSize="13"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
