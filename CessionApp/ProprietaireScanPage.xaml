<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CessionApp.ProprietaireScanPage"
             Title="Scanner pièce d'identité"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">

        <toolkit:CameraView x:Name="CameraView"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            MediaCaptured="OnMediaCaptured" />

        <!-- Panneau de statut -->
        <Border Grid.Row="1"
                BackgroundColor="#EE111111"
                Padding="14,10,14,14">
            <VerticalStackLayout Spacing="5">

                <Grid ColumnDefinitions="20,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="5">

                    <Label x:Name="IconNom"           Grid.Row="0" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextNom"           Grid.Row="0" Grid.Column="1" Text="Nom" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconPrenom"        Grid.Row="1" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextPrenom"        Grid.Row="1" Grid.Column="1" Text="Prénom(s)" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconAdresse"       Grid.Row="2" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextAdresse"       Grid.Row="2" Grid.Column="1" Text="N° et voie" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconCP"            Grid.Row="3" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextCP"            Grid.Row="3" Grid.Column="1" Text="Code postal" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconCommune"       Grid.Row="4" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TextCommune"       Grid.Row="4" Grid.Column="1" Text="Commune" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center"/>

                    <Label x:Name="IconDateNaissance" Grid.Row="5" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False"/>
                    <Label x:Name="TextDateNaissance" Grid.Row="5" Grid.Column="1" Text="Date de naissance" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" IsVisible="False"/>

                    <Label x:Name="IconLieuNaissance" Grid.Row="6" Grid.Column="0" Text="✗" TextColor="#FF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False"/>
                    <Label x:Name="TextLieuNaissance" Grid.Row="6" Grid.Column="1" Text="Lieu de naissance" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" IsVisible="False"/>

                </Grid>

                <Button Text="Terminer"
                        Clicked="OnTerminerClicked"
                        Margin="0,6,0,0"
                        HeightRequest="38"
                        FontSize="13"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
